{
  "compilerOptions": {
    "target":"ES2022", "lib":["ES2022","DOM","WebWorker"],
    "module":"ESNext", "moduleResolution":"Bundler", "strict":true,
    "noEmit":true, "skipLibCheck":true, "allowJs":true, "checkJs":false,
    "resolveJsonModule":true, "esModuleInterop":true
  },
  "include":["src/domain/**/*.ts","src/services/**/*.ts"]
}
